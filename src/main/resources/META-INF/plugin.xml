<idea-plugin>
    <id>com.astra.intellij</id>
    <name>Astra</name>
    <version>0.1.0</version>
    <vendor>APost</vendor>
    <description><![CDATA[
        Local-first API debugging tool: collections, environments, HTTP requests, response viewer, cURL import/export and history.
    ]]></description>
    <idea-version since-build="242"/>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Astra"
                    anchor="right"
                    factoryClass="com.astra.intellij.ui.AstraToolWindowFactory"
                    icon="/icons/astra.svg"/>
    </extensions>
</idea-plugin>
